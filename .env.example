# Base de datos
POSTGRES_USER=growvia
POSTGRES_PASSWORD=growvia_dev
POSTGRES_DB=growvia_crm
DATABASE_URL=postgres://growvia:growvia_dev@localhost:5432/growvia_crm

# Redis (colas: avisos, cargas de Excel, liberación de empresas)
REDIS_URL=redis://localhost:6379

# Backend
PORT=3000
# Mínimo 32 caracteres. En producción, una clave aleatoria distinta guardada en Azure
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
TZ=America/Lima

# Correo (código de verificación y avisos)
# Si SMTP_HOST queda vacío, los correos se muestran en la consola del backend (modo desarrollo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=Growvia CRM <no-responder@growvia.global>
